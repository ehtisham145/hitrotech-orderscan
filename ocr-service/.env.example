# Copy to .env on the VPS and fill in real values. Never commit .env.
# chmod 600 .env after creating it — ops/secrets-check.sh will warn if it's world-readable.

# Shared secret the main app must send as the X-API-Key header. Generate with:
#   openssl rand -hex 32
OCR_API_KEY=

# PaddleOCR language model to load (en, ar, ch, ...).
OCR_LANG=en

# Reject uploads larger than this many bytes.
MAX_UPLOAD_BYTES=10485760

# Reject images whose decoded size exceeds this many megapixels. Inference
# memory tracks pixels, not file bytes — a compact PNG can still open into a
# canvas far larger than anything worth reading.
OCR_MAX_MEGAPIXELS=25

# How many inferences may run at once. A single dense page allocates on the
# order of gigabytes, so on a small host anything above 1 trades a queued
# request for an OOM-killed worker.
OCR_MAX_CONCURRENCY=1

# Pre-processing steps. Screenshots arrive clean, so denoise/contrast mostly
# cost time on them; they still earn their place on photographed receipts.
# Turn one off and compare confidence before keeping the change.
OCR_DENOISE=true
OCR_CONTRAST=true
OCR_DESKEW=true

# Load the PaddleOCR engine at container startup instead of on first request.
# Keep true on an always-on VPS — it removes the first-request cold-start delay.
OCR_EAGER_LOAD=true

# Use structured JSON logs (recommended in prod; plain text is easier to read in dev).
LOG_FORMAT=json

# Host port the service is published on (container always listens on 8080 internally).
OCR_PORT=8000

# uvicorn worker processes. PaddleOCR is CPU-bound — set roughly to vCPU count,
# and only raise --concurrency-sensitive settings after watching `ops/status.sh`.
UVICORN_WORKERS=2

# docker-compose.prod.yml resource caps (this container competes with whatever
# else runs on the VPS, e.g. an existing website).
OCR_MEMORY_LIMIT=4g
OCR_CPU_LIMIT=2

# --- Optional: only needed once a domain points at this VPS (ops/ssl-renew.sh) ---
DOMAIN=
SSL_EMAIL=
