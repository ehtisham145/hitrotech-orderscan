# Copy this file to .env and fill in real values. Never commit .env.

# --- Main Supabase project (server + client) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- External/tenant Supabase project (used by extraction + export routes) ---
EXT_SUPABASE_URL=
EXT_SUPABASE_PUBLISHABLE_KEY=
EXT_SUPABASE_SERVICE_ROLE_KEY=

VITE_EXT_SUPABASE_URL=
VITE_EXT_SUPABASE_PUBLISHABLE_KEY=

# --- OCR service (ocr-service/) ---
# Optional. When set, extraction transcribes the screenshot here first; if the
# service is unreachable, slow or fails, it reads the screenshot directly
# instead, so leaving these blank is a supported setup rather than a broken one.
# On one VPS running both halves via docker-compose.prod.yml, use the internal
# network name rather than the published port:
#   OCR_URL=http://ocr:8080
OCR_URL=
OCR_API_KEY=
# How long to wait on OCR before falling back (ms).
OCR_TIMEOUT_MS=45000

# --- AI extraction (structured fields from the OCR text, or the screenshot) ---
GEMINI_API_KEY=
# Optional. Free, fast, text-only — tried first whenever OCR already produced
# text (i.e. never for the image-fallback case, which always needs vision and
# goes straight to Gemini). Leaving this blank just means every request goes
# to Gemini/the gateway, same as before this existed. Get a key at
# https://console.groq.com/keys
GROQ_API_KEY=
# Reject uploads larger than this before sending them to the model (bytes).
MAX_IMAGE_BYTES=12582912

# --- Template fast-path (src/lib/template-extract.ts) ---
# For the client's own fixed-layout order screenshots: parses known labels
# directly from OCR text and skips the AI call entirely when confident. Keep
# "false" until shadow-mode logs ("[shadow] template would match...") have
# been compared against real Gemini output for a batch — the parser still
# runs and logs either way, this only controls whether it's actually trusted.
TEMPLATE_EXTRACTION_ENABLED=false
# Minimum OCR confidence (0-100) required before the template path is even
# considered. A blurry/unfamiliar image fails this and falls through to AI.
TEMPLATE_MIN_CONFIDENCE=90


# --- Email (Resend) ---
RESEND_API_KEY=
INVITE_FROM_EMAIL=

# --- Background jobs (Inngest) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Misc ---
APP_URL=
WEBHOOK_SIGNING_SECRET=

# --- VPS deployment (docker-compose.prod.yml, ops/) ---
# Host port the app is published on (container always listens on 8080 internally).
APP_PORT=3000
APP_MEMORY_LIMIT=2g
APP_CPU_LIMIT=2
# Only needed once a domain points at this VPS (ops/ssl-renew.sh).
DOMAIN=
SSL_EMAIL=
# Only needed for ops/migrate.sh (Supabase personal access token, NOT the
# service_role key — from https://supabase.com/dashboard/account/tokens).
SUPABASE_ACCESS_TOKEN=
