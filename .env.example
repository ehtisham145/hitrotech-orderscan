# Copy this file to .env and fill in real values. Never commit .env.

# --- Main Supabase project (server + client) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- External/tenant Supabase project (used by extraction + export routes) ---
EXT_SUPABASE_URL=
EXT_SUPABASE_PUBLISHABLE_KEY=
EXT_SUPABASE_SERVICE_ROLE_KEY=

VITE_EXT_SUPABASE_URL=
VITE_EXT_SUPABASE_PUBLISHABLE_KEY=

# --- OCR service (ocr-service/) ---
# If both this app and ocr-service run on the same VPS via docker-compose.prod.yml,
# use the internal Docker network name instead of the public port:
#   OCR_URL=http://ocr:8080
# Otherwise (different host, or ocr-service not deployed yet) use its public URL.
OCR_URL=
OCR_API_KEY=

# --- AI extraction (structured data from OCR text) ---
GEMINI_API_KEY=


# --- Email (Resend) ---
RESEND_API_KEY=
INVITE_FROM_EMAIL=

# --- Background jobs (Inngest) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Misc ---
APP_URL=
WEBHOOK_SIGNING_SECRET=

# --- VPS deployment (docker-compose.prod.yml, ops/) ---
# Host port the app is published on (container always listens on 8080 internally).
APP_PORT=3000
APP_MEMORY_LIMIT=2g
APP_CPU_LIMIT=2
# Only needed once a domain points at this VPS (ops/ssl-renew.sh).
DOMAIN=
SSL_EMAIL=
# Only needed for ops/migrate.sh (Supabase personal access token, NOT the
# service_role key — from https://supabase.com/dashboard/account/tokens).
SUPABASE_ACCESS_TOKEN=
