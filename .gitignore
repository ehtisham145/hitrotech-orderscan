# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Environment variables (secrets — never commit)
.env
.env.*
!.env.example

# ops state (deploy history, monitor logs, local backups) — root app + ocr-service
ops/.state/
ocr-service/ops/.state/
/backups/
ocr-service/backups/

# Python (ocr-service)
__pycache__/
*.pyc
.venv/
.venv-test/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# TypeScript / test output
*.tsbuildinfo
coverage/
.nyc_output/

# Transfer/build artifacts (e.g. one-off VPS deploy packages) — never meant
# to be committed, only ever produced locally or on a server.
*.tar.gz
*.tar

# Keys/certs — defense in depth; real secrets belong in .env or the VPS,
# never in the repo.
*.pem
*.key
*.crt
*.p12

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
